# SpotiFLAC Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: API Server Port (default: 8080)
API_PORT=8080

# Optional: Download directory (default: /tmp/spotiflac_downloads)
DOWNLOAD_DIR=/tmp/spotiflac_downloads

# Optional: Spotify API credentials for better search results
# Get these from https://developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Enable debug mode (default: false)
DEBUG=false
