{
  "name": "zFlac Downloader",
  "description": "Telegram bot and web interface for downloading high-quality FLAC music",
  "repository": "https://github.com/Anggahrm/SpotiFLAC-Mobile",
  "keywords": ["telegram", "bot", "music", "flac", "tidal", "qobuz", "web"],
  "env": {
    "TELEGRAM_BOT_TOKEN": {
      "description": "Your Telegram bot token from @BotFather (optional if only using web)",
      "required": false
    },
    "SPOTIFY_CLIENT_ID": {
      "description": "Spotify API client ID (optional)",
      "required": false
    },
    "SPOTIFY_CLIENT_SECRET": {
      "description": "Spotify API client secret (optional)",
      "required": false
    },
    "DEBUG": {
      "description": "Enable debug mode",
      "value": "false",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "heroku/go"
    }
  ],
  "scripts": {
    "postdeploy": "echo 'Deployment complete'"
  }
}
